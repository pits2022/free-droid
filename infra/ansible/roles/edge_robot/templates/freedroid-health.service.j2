[Unit]
Description=Free-Droid vital-function health check (network / hardware / software)
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=oneshot
# Runs as root: it may `systemctl restart` wg-quick@wg0 / ollama / freedroid
# (self-heal) and writes /run/freedroid/health.json + the safe-mode flag.
# Assert we're on the Pi so a transient device-tree read can't silently SKIP the
# CRITICAL hardware checks (a missing device then FAILs -> safe-mode, fail-safe).
Environment=FREEDROID_ASSUME_PI=1
{# Idézőjelben ÉS escape-elve. Idézés nélkül a systemd a SZÓKÖZNÉL kettévágja az
   értéket; escape nélkül pedig két külön baj van, és a MÁSODIK a csendes:
     - a `"` és a `\` az idézett szakaszon belül vezérlő karakter -> a unit betöltése
       elhasal (hangos hiba),
     - a `%` viszont SPECIFIKÁTOR: a `%h` némán a home könyvtárra cserélődik, azaz az
       érték csendben MÁSSÁ válik. Ezért kell a `%%`.
   A sorrend kötött: előbb a backslash, különben a saját escape-jeinket escape-elnénk. #}
{% for kulcs, ertek in robot_env.items() %}
Environment="{{ kulcs }}={{ ertek | replace('\\', '\\\\') | replace('"', '\\"') | replace('%', '%%') }}"
{% endfor %}
ExecStart={{ robot_venv_bin }}/freedroid-health
