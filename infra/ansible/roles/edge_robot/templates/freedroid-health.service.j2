[Unit]
Description=Free-Droid vital-function health check (network / hardware / software)
After=network-online.target ollama.service
Wants=network-online.target

# 🔴 AZ ORCHESTRÁTOR UTÁN. Ez nem óvatosság, hanem MÉRT ütközés javítása (2026-09-18):
# a timer `OnBootSec=60`-nál tüzel, a `freedroid-selfcheck` viszont 102 másodpercig fut
# és `Before=freedroid.service` — vagyis a bootkori health-check MINDIG olyankor
# érkezett, amikor az orchestrátor még el sem indult. A `check_orchestrator_service`
# CRITICAL, tehát minden egyes bootnál safe módba tette a robotot, és a jelző a
# KÖVETKEZŐ timer-ébredésig (10 perc) ott maradt.
#
# Az `After=` azért a helyes eszköz az `OnBootSec` emelése helyett, mert a selfcheck
# hossza VÁLTOZIK (modellek, hardver), egy nagyobb konstans meg csak odébb tolná az
# ütközést. Az `After=` akkor rendez, ha a `freedroid.service` ugyanabban a
# tranzakcióban indul (bootkor mindig), a későbbi timer-ébredéseknél no-op.
#
# ⚠️ `Wants=` SZÁNDÉKOSAN NINCS mellé: a health-check ne INDÍTSA el az orchestrátort.
# Egy kézi `systemctl stop freedroid` után a következő timer-ébredés visszakapcsolná —
# és pont azt a „nem fut az orchestrátor" állapotot fedné el, amit mérnie kell.
After=freedroid.service

[Service]
Type=oneshot
# Runs as root: it may `systemctl restart` wg-quick@wg0 / ollama / freedroid
# (self-heal) and writes /run/freedroid/health.json + the safe-mode flag.
# Assert we're on the Pi so a transient device-tree read can't silently SKIP the
# CRITICAL hardware checks (a missing device then FAILs -> safe-mode, fail-safe).
Environment=FREEDROID_ASSUME_PI=1
# EGY forrás a szolgáltatásnak ÉS a kézi menetnek (`set -a; . /etc/freedroid.env`).
# A `-` előtag SZÁNDÉKOS: ha a fájl hiányzik, a robot INDULJON EL (némán kevesebbet tud,
# pl. látás nélkül) — egy néma robot a színpadon rosszabb, mint egy vak. Hogy a hiány ne
# maradjon észrevétlen: az orchestrátor indulási sora mondja ki („látás kihagyva — a
# látás ki van kapcsolva"), és a `freedroid-health` `vision` checkje ekkor zöld — a
# CSÖKKENTETT képesség nem hiba. Ez a plafon: a hiányzó fájl csendben kevesebbet tudó
# robotot ad, nem halottat. Külön check-et NEM ér meg: az Ansible mindig kiírja a fájlt,
# és a kézi menet mostantól UGYANEZT olvassa — a két út nem tud elcsúszni egymástól.
EnvironmentFile=-/etc/freedroid.env
ExecStart={{ robot_venv_bin }}/freedroid-health
